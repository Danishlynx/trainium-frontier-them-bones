# Switches of the final Round 2 recipe, for source/train.py.
# This is the job line I queued for this recipe on my own server. The scored file
# (../submission/train.py) has the same values folded in as constants, so it needs none of them.
#
# Launch (64 ranks, LNC 2), with these exported:
#   NEURON_LOGICAL_NC_CONFIG=2 torchrun --standalone --nproc_per_node=64 train.py \
#       --depth 18 --aspect-ratio 85 --device-batch-size 2 --max-train-seconds 14400
#
# R2_SCHED_STAGE=1 reached my runs through a small launcher script; it is listed here directly.

NEURON_COMPETITION_R2_EVAL_PUBLIC=0
R2_VE=2
R2_BUNDLE=1
R2_UNET=1
R2_UNET_INIT=1.0
R2_WD=0.05
R2_NGRAM=1
R2_NGRAM_ROWS=1073741824
R2_NGRAM_ORDERS=2,3
R2_NGRAM_PATH=/dev/shm
R2_NGRAM_SAVE_SECONDS=600
R2_NGRAM_STALE=1
R2_NGRAM_PREFAULT=1
R2_NGRAM_SAVE_DTYPE=int8
R2_LEAN_EMBED_1536=1
R2_SLAB_COPY=1
R2_MLP=fused8
R2_MLP_TB=1024
R2_MLP_DW=fmajor
R2_RS_UNSPLIT=1
R2_ACC_FOLD=1
R2_HOST_IDLE=1
R2_OPT_COMPILED=1
TORCH_LOGS=recompiles,graph_breaks
R2_WARMDOWN=0.85
R2_FINAL_LR=0.01
R2_SCHED_SCOPE=dense
R2_MLP_FP8=both
R2_ATTN_FP8=both
R2_MLP_PRECAST=1
R2_ATTN_PRECAST=1
